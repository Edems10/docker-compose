# Copy to .env and fill in real values:
#   cp .env.example .env && chmod 640 .env && chown root:edems .env
# .env is read automatically by `docker compose` from this directory.

# ---- identity / paths ----
PUID=1000
PGID=1000
TZ=Europe/Prague
CONFIG_ROOT=/docker_config
DATA_ROOT=/pool0/Heh

# ---- PIA VPN (gluetun) ----
OPENVPN_USER=pXXXXXXX
OPENVPN_PASSWORD=changeme
VPN_SERVER_REGIONS=Netherlands

# ---- qBittorrent web UI ----
# must match the credentials set inside qBittorrent itself
QBITTORRENT_USER=admin
QBITTORRENT_PASS=changeme

# ---- Plex ----
# one-time claim token from https://plex.tv/claim (expires after 4 minutes)
PLEX_CLAIM=claim-xxxxxxxxxxxxxxxxxxxx

# ---- Cloudflare tunnel ----
# Zero Trust > Networks > Tunnels > your tunnel > Install connector
CLOUDFLARE_TUNNEL_TOKEN=changeme

# ---- MyAnonaMouse IP updater ----
MOUSEHOLE_AUTH_PASSWORD=changeme

# ---- Immich database ----
# changing the password after first init also needs:
#   docker exec -it immich-database psql -U immich -c "ALTER USER immich WITH PASSWORD '...'"
IMMICH_DB_NAME=immich
IMMICH_DB_USER=immich
IMMICH_DB_PASSWORD=changeme

# ---- flaresolverr ----
LOG_LEVEL=info
LOG_HTML=false
CAPTCHA_SOLVER=none
